// Alloy config - collect logs from both Docker Compose and Swarm containers

logging {
  level  = "debug"
  format = "logfmt"
}

// Discover regular Docker containers (Compose, standalone)
discovery.docker "docker_containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

// Discover Docker Swarm tasks
discovery.dockerswarm "swarm_tasks" {
  host             = "unix:///var/run/docker.sock"
  role             = "tasks"
  refresh_interval = "10s"
}

// Filter and relabel Docker containers
discovery.relabel "docker_filtered" {
  targets = discovery.docker.docker_containers.targets

  // Only keep containers with loki.enabled=true label
  rule {
    source_labels = ["__meta_docker_container_label_loki_enabled"]
    regex         = "true"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
}

// Filter and relabel Swarm tasks
discovery.relabel "swarm_filtered" {
  targets = discovery.dockerswarm.swarm_tasks.targets

  // Only keep running tasks
  rule {
    source_labels = ["__meta_dockerswarm_task_desired_state"]
    regex         = "running"
    action        = "keep"
  }

  // Only keep containers with loki.enabled=true label
  rule {
    source_labels = ["__meta_dockerswarm_container_label_loki_enabled"]
    regex         = "true"
    action        = "keep"
  }

  // Map Swarm container ID to Docker container ID
  rule {
    source_labels = ["__meta_dockerswarm_task_container_id"]
    target_label  = "__meta_docker_container_id"
  }

  rule {
    source_labels = ["__meta_dockerswarm_service_name"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_dockerswarm_task_id"]
    target_label  = "task_id"
  }

  rule {
    source_labels = ["__meta_dockerswarm_container_label_com_docker_swarm_task_name"]
    target_label  = "container"
  }
}

// Merge both sets of targets
discovery.relabel "merge_targets" {
  targets = concat(
    discovery.relabel.docker_filtered.output,
    discovery.relabel.swarm_filtered.output,
  )
}

// Scrape logs from both Docker and Swarm containers
loki.source.docker "all_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.merge_targets.output
  forward_to = [loki.write.loki_endpoint.receiver]
}

// Send to Loki
loki.write "loki_endpoint" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
