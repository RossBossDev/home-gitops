// Simple Alloy config - collect logs from ALL containers

logging {
  level  = "debug"
  format = "logfmt"
}

// Discover all Docker containers (not Swarm-specific)
discovery.docker "all_containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

// Filter and relabel - only containers with loki.enabled=true
discovery.relabel "add_labels" {
  targets = discovery.docker.all_containers.targets

  // Only keep containers with loki.enabled=true label
  rule {
    source_labels = ["__meta_docker_container_label_loki_enabled"]
    regex         = "true"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
    target_label  = "service_name"
  }
}

// Scrape logs from ALL containers
loki.source.docker "all_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.add_labels.output
  forward_to = [loki.write.loki_endpoint.receiver]
}

// Send to Loki
loki.write "loki_endpoint" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
